NODE_ENV=development
PORT=3000

# Keep these values in sync with the workspace .env used by Docker Compose.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5544
POSTGRES_DB=nexus_manga
POSTGRES_USER=nexus_manga
POSTGRES_PASSWORD=nexus_manga_dev

# Public R2 bucket domain used for uploaded manga covers
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://images.example.com
